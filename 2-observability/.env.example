# ==============================================================================
# Mass-run configuration
# Copy this file to '.env' and edit before running 'docker compose up'
# ==============================================================================

# =============================================================================
# REQUIRED: Recipe execution
# =============================================================================

# Recipe to run (e.g., org.openrewrite.java.search.FindTypes)
RECIPE=org.openrewrite.java.search.FindTypes

# S3 path for output artifacts (data-tables.zip, patches.zip, runs.zip)
OUTPUT_LOCATION=s3://your-bucket/mass-run-output

# Path to repos.csv inside container (mounted via docker-compose.yml)
REPOS_CSV_LOCATION=/app/repos.csv

# =============================================================================
# REQUIRED for PR creation: SCM configuration
# =============================================================================

# Set to "true" to create PRs after recipe execution
CREATE_PRS=false

# Path to scm-mapping.csv inside container (mounted via docker-compose.yml)
# Required when CREATE_PRS=true
SCM_MAPPING_CSV=/app/scm-mapping.csv

# =============================================================================
# OPTIONAL: License and Moderne platform
# =============================================================================

# Moderne CLI license key (passed at runtime, not baked into image)
# MODERNE_LICENSE_KEY=your-license-key

# Moderne platform configuration (for recipe catalog and LST sync)
# MODERNE_TOKEN=your-moderne-token
# MODERNE_TENANT=https://app.moderne.io

# =============================================================================
# OPTIONAL: Recipe execution settings
# =============================================================================

# Recipe options (e.g., "-Pfoo=bar -Pbaz=bop")
# RECIPE_OPTIONS=

# Timeout in seconds for recipe execution (0 = no timeout)
# RECIPE_TIMEOUT=0

# Organization name for syncing repos
# ORGANIZATION=

# Path to recipes.csv (defines available recipes)
# RECIPES_CSV_LOCATION=

# =============================================================================
# OPTIONAL: PR creation settings
# =============================================================================

# Title for created PRs
# PR_TITLE=Automated changes from recipe

# Body text for created PRs
# PR_BODY=

# Branch name for changes (default: moderne/<recipe-suffix>)
# BRANCH_NAME=

# Commit message for changes
# COMMIT_MESSAGE=

# =============================================================================
# OPTIONAL: S3/LST Configuration
# =============================================================================

# S3 bucket URL for pre-built LSTs
# LST_BUCKET=s3://your-lst-bucket

# S3-compatible endpoint URL (e.g., for MinIO)
# S3_ENDPOINT=

# AWS region
# S3_REGION=

# AWS profile name
# S3_PROFILE=

# =============================================================================
# OPTIONAL: CLI version
# =============================================================================

# Specific CLI version (defaults to latest stable if not set)
# MODERNE_CLI_VERSION=3.50.0

# CLI stage: "stable" (default) or "staging"
# MODERNE_CLI_STAGE=stable
